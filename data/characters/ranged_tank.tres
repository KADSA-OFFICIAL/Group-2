[resource]
script = ExtResource("1_chardata")
role = 1
secondary_role = 1
character_id = &"ranged_tank"
display_name = "원거리/탱커(겸직)"
skills = Array[ExtResource("11_skilldef")]([ExtResource("12_sweep"), ExtResource("13_overload")])
playable = true
basic_attack_range = 380.0
basic_attack_strike_radius = 55.0
basic_attack_effect_id = &"shock_stun"
description = "로스터의 겸직(원거리딜러 + 탱커) 슬롯. 이 자리는 원래 같은 id 의 플레이스홀더가 들고 있다가 태희로 교체됐고(#228), 태희가 순혈 원거리로 옮겨 가면서(#263) 다시 플레이스홀더가 되었다. **#336 에서 전투(평타 + 고유 스킬 2종)를 저작했다** — 로스터에서 마지막으로 남아 있던 미저작 인물이다. **[미정] 이름·개성은 아직 없다.** character_id 와 display_name 을 역할 표기 그대로 둔 이유가 그것이다 — 임의로 짓지 않는다(미나·태희·설아·하랑·강지는 사용자가 이름을 준 뒤에 붙었다). 스텟(1100/110/110)은 태희가 물려받았던 값 그대로이며 [임시값]이다 — 겸직이라 순혈 딜러보다 체력·방어가 높고 근력이 낮다. #336 에서 스텟은 건드리지 않았다(요청에 없었다). 평타 = **낙뢰**: 자신을 중심으로 한 **원형 사거리**(380) 안의 적을 노리고, 날아가는 탄 없이 그 **대상 자리에 작은 원**(반경 55)이 즉시 떨어져 원 안의 적이 전부 맞는다. 맞은 적은 **0.3초 기절**한다(shock_stun). 로스터의 세 번째 평타 모양이다 — 미나·하랑·강지는 근접 즉시타격, 태희는 투사체, 이쪽은 낙뢰다. 투사체와 달리 **빗나가지 않는 대신** 판정이 대상 자리에 묶여 있어 조준으로 더 많이 맞힐 수 없다(적이 뭉쳐 있을 때만 여러 명이 맞는다). 고유 스킬 둘(#336): Q = 부채꼴 밀어내기(data/skills/ranged_tank_sweep.tres) — 조준 방향 부채꼴로 때리고 맞은 적을 바깥으로 민다. 낙뢰가 전제하는 '거리'를 되찾는 버튼이다. E = 과부하(data/skills/ranged_tank_overload.tres) — 5초 동안 공속 증가 + 사거리 제한 해제. 평타가 기절을 실어 나르므로 공속 증가가 곧 CC 증가이고, 사거리까지 풀리면 5초 동안 전장 전체를 끊는다. 겸직의 두 몫(원거리 화력 + 탱커의 CC)이 한 버튼에 들어간다. 겸직이므로 원거리딜러·탱커 두 역할 카운트에 각각 기여한다. 워크 시트도 초상도 없어 전투에서 도형 플레이스홀더(shape_ranged)로 보이고 메타 화면에는 초상이 뜨지 않는다."
stats = SubResource("PlayerStats_ranged_tank")
sprite_texture = ExtResource("9_shape")
tint = Color(1, 0.3, 0.3, 1)
sprite_scale = Vector2(2, 2)
