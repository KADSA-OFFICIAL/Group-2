[resource]
script = ExtResource("1_chardata")
role = 0
secondary_role = 0
character_id = &"mina"
display_name = "미나"
playable = true
description = "로스터의 순혈 탱커 슬롯(#259). 원래는 겸직(탱커+버퍼)이었고 그 자리는 shipduck(#334 에서 강지로 다시 만들었다)이 이어받았다가 #328 에서 하랑에게 넘어갔다. 스텟은 플레이스홀더에서 이어받은 [임시값]이다. 전투 자원으로 **게이지**를 갖는다 — 파티 전체(아군 AI 포함)와 자신의 평타가 채우고, 시간으로는 줄지 않는다. 고유 스킬 둘 다 게이지에 비례해 세지고 시전하면 게이지를 전량 소모한다. Q = 방울(data/skills/mina_bubble_trap.tres): 날아가 터지며 범위 안 적에게 피해 + 이동 봉인, 게이지가 많을수록 범위가 넓다. E = 보호막 폭발(data/skills/mina_shield_burst.tres): 자기와 최저 체력 파티원에게 보호막, 깨지거나 만료되면 광역 폭발, 게이지가 많을수록 보호막이 두껍다 — 버퍼 3단계가 기대는 보호막 출처는 그대로다(#231). 평타는 근접이고, 평타 3회마다 잃은 체력 비례 회복 + 회복량 비례 광역 피해가 나가는 패시브를 갖는다(data/skills/mina_attack_heal_burst.tres, #233). 개성 미정."
stats = SubResource("PlayerStats_mina")
skills = Array[ExtResource("11_skilldef")]([ExtResource("12_skill"), ExtResource("13_passive"), ExtResource("14_bubble")])
skill_gauge_max = 100
skill_gauge_gain_per_attack = 2
sprite_texture = ExtResource("9_shape")
portrait = ExtResource("20_portrait")
tint = Color(0.2, 0.8, 0.8, 1)
sprite_scale = Vector2(2, 2)
walk_frames = ExtResource("10_walk")
walk_sprite_scale = Vector2(0.25, 0.25)
walk_sprite_offset = Vector2(0, -155)
