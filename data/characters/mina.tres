character_id = &"mina"
display_name = "미나"
playable = true
description = "로스터의 겸직(탱커 + 버퍼) 슬롯. 플레이스홀더였던 tank_buffer 를 교체한 인물이다(#224). 스텟은 그 플레이스홀더의 값을 그대로 이어받은 [임시값]이다. 고유 스킬은 보호막 폭발(data/skills/mina_shield_burst.tres) — 버퍼 3단계가 기대는 보호막 출처다(#231). 평타는 근접이고, 평타 3회마다 잃은 체력 비례 회복 + 회복량 비례 광역 피해가 나가는 패시브를 갖는다(data/skills/mina_attack_heal_burst.tres, #233). 개성 미정."
stats = SubResource("PlayerStats_mina")
