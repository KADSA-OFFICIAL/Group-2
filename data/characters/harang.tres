[resource]
script = ExtResource("1_chardata")
role = 2
secondary_role = 2
character_id = &"harang"
display_name = "하랑"
playable = true
description = "로스터의 겸직(버퍼 + 원거리딜러) 슬롯(#315). 플레이스홀더였던 buffer_ranged 를 교체한 인물이다 — 태희가 ranged_tank 를(#228), 설아가 buffer_ranged 를(#220) 교체한 것과 같은 방식이다. 스텟(900/110/80/신앙130)은 그 플레이스홀더의 값을 그대로 이어받은 [임시값]이며, 원래는 설아가 이 자리에서 쓰던 값이다(설아는 #276 에서 순혈 버퍼로 옮겼다). **아트는 원래 이 인물의 것이다**: 이름이 정해지지 않은 채 초상과 워크 시트가 먼저 들어와 buffer_pure -> buffer_ranged 를 거쳐 자리를 옮겨 다녔고, 이번에 이름이 붙었다. 그래서 워크 시트 파일 이름이 buffer_pure_walk.png 로 남아 있다 — 재임포트와 UID 갱신이 따라붙는 변경이라 파일명은 바꾸지 않았다(assets/sprites/characters/README.md 참고). 초상은 girl_green.png 에서 전용 아트 harang.png 로 교체했다. 평타는 근접 즉시타격이다(basic_attack_* 미지정). 겸직이므로 버퍼·원거리딜러 두 역할 카운트에 각각 기여한다. 개성/고유 스킬 미정 — 확정된 것은 미나(#259)·태희(#263)·설아(#276) 셋뿐이다."
stats = SubResource("PlayerStats_harang")
sprite_texture = ExtResource("9_shape")
portrait = ExtResource("10_portrait")
tint = Color(0.3, 1, 0.3, 1)
sprite_scale = Vector2(2, 2)
walk_frames = ExtResource("10_walk")
walk_sprite_scale = Vector2(0.25, 0.25)
walk_sprite_offset = Vector2(0, -177)
