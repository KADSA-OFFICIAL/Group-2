[gd_resource type="Resource" script_class="SkillData" load_steps=2 format=3]

[ext_resource type="Script" path="res://entities/character/SkillData.gd" id="1_skill"]

[resource]
script = ExtResource("1_skill")
skill_id = &"seola_wave"
display_name = "퍼지는 파동"
description = "설아 고유 스킬(Q, #276). 설아 자리에서 원이 **실제로 퍼져 나간다** — 고정 반경 광역(aoe_radius)이 아니라 판정이 시간에 따라 커지므로, 파동이 닿는 **그 순간** 적중한다. 달려서 피할 수 있고, 먼 대상일수록 늦게 맞는다. 그 차이가 이 스킬의 성질이라 연출로 흉내 내지 않고 실제로 퍼지게 했다(태희 레이저의 BeamEffect 는 반대로 판정이 발사 순간에 끝나고 그림만 남는다). 닿은 **적에게는 base_power 피해**, 닿은 **아군은 ally_heal 회복**이다. 한 대상은 한 번만 맞는다 — 파동이 되돌아오지 않는다. 조준 방향을 쓰지 않는다: 원은 방향이 없고, 이 스킬이 조준을 요구하지 않는 것이 의도다. 범위가 넓어서(wave_radius 720) 흩어진 파티에도 닿는다 — 태희 레이저 길이(520)보다 크다. 파동 속도가 곧 '피할 수 있는가'를 정한다: 너무 빠르면 즉발과 구분되지 않고, 너무 느리면 아군 회복이 늦어 죽은 뒤에 닿는다. [이름 미정] — display_name 은 기능을 그대로 적은 임시 이름이다. 수치는 전부 [임시값]이다."
summary = "설아 자리에서 파동이 퍼져 나간다. 판정이 시간에 따라 커지므로 파동이 닿는 그 순간에 적중하며, 먼 대상일수록 늦게 맞고 달려서 피할 수도 있다. 적에게는 피해를, 아군에게는 회복을 준다. 한 대상은 한 번만 맞는다."
base_power = 140
scales_with_faith = true
cooldown = 10.0
ally_heal = 160
wave_radius = 720.0
wave_speed = 600.0
input_slot = 1
