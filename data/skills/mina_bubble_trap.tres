[gd_resource type="Resource" script_class="SkillData" load_steps=2 format=3]

[ext_resource type="Script" path="res://entities/character/SkillData.gd" id="1_skill"]

[resource]
script = ExtResource("1_skill")
skill_id = &"mina_bubble_trap"
display_name = "방울"
description = "미나 고유 스킬(Q, #259). 방울을 날려 적에 닿으면 그 자리에서, 아무것도 맞히지 못하면 최대 사거리에서 터진다. 터진 자리 원형 범위 안의 적에게 피해를 주고 bubble_trap(이동 봉인)을 건다. **범위가 미나의 게이지에 비례해 커진다** — gauge_radius_bonus_percent = 1.0 이므로 게이지가 가득이면 반경이 2배(70 -> 140)다. 시전하면 게이지를 전량 소모한다. 게이지가 0 이어도 최소 반경으로 발동된다. [이름 미정] — display_name 은 기능을 그대로 적은 임시 이름이다. 수치는 전부 [임시값]이며 실측으로 잡는다."
summary = "방울을 날려 적에 닿은 자리에서, 아무것도 맞히지 못하면 최대 사거리에서 터진다. 터진 자리의 적에게 피해를 주고 이동을 봉인한다. 봉인된 적은 움직이지 못할 뿐 공격은 계속하므로 원거리 적은 여전히 위험하다. 미나의 게이지가 많을수록 범위가 넓어진다."
base_power = 150
scales_with_faith = true
cooldown = 8.0
aoe_radius = 70.0
projectile_speed = 420.0
projectile_range = 480.0
apply_effect_id = &"bubble_trap"
gauge_radius_bonus_percent = 1.0
consumes_gauge = true
input_slot = 1
