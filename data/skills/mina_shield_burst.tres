[gd_resource type="Resource" script_class="SkillData" load_steps=2 format=3]

[ext_resource type="Script" path="res://entities/character/SkillData.gd" id="1_skill"]

[resource]
script = ExtResource("1_skill")
skill_id = &"mina_shield_burst"
display_name = "보호막 폭발"
description = "미나 고유 스킬. 자기 자신과 파티에서 가장 체력이 낮은 파티원에게 보호막을 준다. 그 보호막이 적의 공격으로 깨지거나 지속시간이 끝나면, 대상이 있던 자리에서 원형 범위로 광역 피해가 터진다. 지켜 준 것이 그대로 공격이 되는 구조다. 설계 §3 의 [확정 제약](고유 스킬 중 일부는 힐/보호막을 제공해야 한다)을 이 스킬이 충족한다 — 버퍼 3단계가 기대는 보호막 출처다. [이름 미정] — display_name 은 기능을 그대로 적은 임시 이름이다. 발동 키는 E 다(#237). 수치는 전부 [임시값]이며 발동 구현 후 실측으로 잡는다. 대상 선정과 폭발 조건은 필드가 아니라 이 설명과 Player 의 구현이 계약이다. 효과 구현: 누르기 1회로 두 대상에게 보호막, 2회로 살아 있는 보호막을 즉시 전부 폭발, 깨짐·만료로도 각자 폭발한다(#239). 게이지 연동(#259): 보호막 양은 **대상의 최대 체력과 무관한 절대값**이다 — shield_base(100) 가 최소 보장치이고, 게이지 비율에 비례해 shield_gauge_bonus(150) 까지 더해진다(게이지 가득이면 250). 이 보호막은 받는 사람의 그릇이 아니라 시전자의 게이지에서 나오는 것이라 절대값으로 둔다. 받는 쪽 총량 한도는 없다(#261 에서 제거) — 이 값이 대상의 최대 체력과 무관하게 그대로 들어간다. 시전하면 게이지를 전량 소모한다. 두 번째 누르기(즉시 폭발)는 게이지를 소모하지 않는다 — 소모는 보호막 생성의 비용이다."
base_power = 200
scales_with_faith = true
shield_base = 100
shield_gauge_bonus = 150
consumes_gauge = true
shield_duration = 3.0
cooldown = 6.0
aoe_radius = 90.0
input_slot = 2
