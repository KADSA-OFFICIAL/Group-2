[gd_resource type="Resource" script_class="SkillData" load_steps=2 format=3]

[ext_resource type="Script" path="res://entities/character/SkillData.gd" id="1_skill"]

[resource]
script = ExtResource("1_skill")
skill_id = &"seola_empower"
display_name = "고양"
description = "설아 고유 스킬(E, #276). 시전하면 **파티 전원**(설아 자신 포함, 아군 AI 포함)에게 empowered(data/status_effects/empowered.tres)를 건다. 아군 AI 도 받는 이유: 이 효과가 바꾸는 것은 '그 캐릭터가 무엇을 할 수 있는가'이고 아군 AI 도 평타는 친다 — 조종 중인 한 명만 받으면 파티 버프가 아니라 자기 버프가 된다. 시전만 사람이 한다(docs §4). 지속시간·흡혈 비율·처형 부여는 **효과 리소스가 소유한다** — 효과 자신의 성질이라 여기 다시 적지 않는다(기절 지속시간을 stun.tres 가 갖는 것과 같은 규약). 조준도 범위도 없다: 대상이 '파티 전원'으로 이미 정해져 있어 겨눌 것이 없다. 그래서 base_power 도 0 이다 — 이 스킬은 스스로 피해를 내지 않고 파티가 내는 피해를 바꾼다. 3초 동안 파티 전체가 흡혈 + 처형을 얻는 것은 짧지만 매우 강해서 쿨타임이 길다. [이름 미정] — display_name 은 기능을 그대로 적은 임시 이름이다. 수치는 [임시값]이다."
summary = "파티 전원에게 잠시 동안 고양을 건다. 조종 중인 캐릭터뿐 아니라 아군 AI 도 함께 받는다. 스스로 피해를 내지 않고 파티가 내는 피해를 바꾸는 스킬이라 조준도 범위도 없다."
base_power = 0
scales_with_faith = false
cooldown = 24.0
party_effect_id = &"empowered"
input_slot = 2
