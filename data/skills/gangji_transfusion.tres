[gd_resource type="Resource" script_class="SkillData" load_steps=2 format=3]

[ext_resource type="Script" path="res://entities/character/SkillData.gd" id="1_skill"]

[resource]
script = ExtResource("1_skill")
skill_id = &"gangji_transfusion"
display_name = "수혈"
description = "강지 평타 패시브(#334). 평타로 **실제로 들어간 피해**의 35% 만큼 **체력 비율이 가장 낮은 아군**을 회복시킨다(강지 자신도 후보다). 평타 자체는 바뀌지 않는다 — 근접 즉시타격 그대로다. 다른 평타 패시브와 트리거가 다르다: 미나 3타·태희 4타·설아 3타는 every_n_attacks 주기이고 기준이 평타 **발생**이지만, 이쪽은 **평타 1회마다**이고 기준이 **들어간 피해**다. 그래서 발동 지점도 _apply_attack_passives()(주기) 가 아니라 _resolve_attack_hit()(평타가 닿은 자리) 이고, 빗나가면 회복되지 않는다. 원거리 3단계 피흡이 같은 자리에서 같은 기준을 쓴다 — 다른 점은 회복하는 쪽이 자기가 아니라 아군이라는 것뿐이다. 이것이 강지의 성격을 정한다: **딜을 넣지 않으면 파티가 회복되지 않는다.** 버퍼가 뒤에 서서 버튼만 누르는 것이 아니라 앞에서 때려야 한다. scales_with_faith 를 끈 이유: 피해가 이미 강지 스텟(근력 -> 물공)을 거쳐 나온 값이라 여기서 신앙심을 다시 곱하면 같은 스텟이 두 번 실린다. base_power 0 — 이 스킬은 스스로 피해를 내지 않는다. input_slot NONE — 키에 걸리지 않는 패시브다. 35% 는 [임시값]이다: 강지 물공 200 이 매머드 수인(물방 307)에게 넣는 79 의 35% = 28 이고, 평타 쿨다운 0.5초라 초당 약 55 다."
summary = "평타로 실제로 들어간 피해에 비례해 체력 비율이 가장 낮은 아군을 회복시킨다. 강지 자신도 대상이 될 수 있다. 빗나가면 회복되지 않는다 — 앞에서 때려야 파티가 회복된다."
base_power = 0
scales_with_faith = false
attack_damage_to_ally_heal_percent = 0.35
