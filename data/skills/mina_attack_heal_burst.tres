[gd_resource type="Resource" script_class="SkillData" load_steps=2 format=3]

[ext_resource type="Script" path="res://entities/character/SkillData.gd" id="1_skill"]

[resource]
script = ExtResource("1_skill")
skill_id = &"mina_attack_heal_burst"
display_name = "3타 회복 폭발"
description = "미나 평타 패시브. 미나 평타는 근접이며, 평타가 3번 나갈 때마다(적중이 아니라 발생 기준) 자기 자신이 잃은 체력에 비례해 회복하고, 그때 실제로 회복한 양에 비례해 주변 원형 범위의 적 전체에 피해를 준다. 체력이 가득 차 있으면 회복이 0이므로 광역 피해도 0이다 — 몰릴수록 세지는 역전 장치가 의도다. 발동형 스킬이 아니라 평타에 붙는 패시브이므로 base_power 를 쓰지 않는다(피해는 회복량에서 나온다). 설계 §3 티어2(개별 유닛 개성)에 해당하며 시너지가 아니므로 파티 구성과 무관하게 항상 작동한다. [이름 미정] — display_name 은 기능을 그대로 적은 임시 이름이다. 수치는 전부 [임시값]이다."
summary = "평타가 일정 횟수 나갈 때마다 잃은 체력에 비례해 회복하고, 그때 회복한 양에 비례해 주변 적에게 피해를 준다. 체력이 가득 차 있으면 회복도 피해도 0 이다 — 몰릴수록 세진다."
base_power = 0
scales_with_faith = false
aoe_radius = 90.0
every_n_attacks = 3
heal_missing_hp_percent = 0.2
heal_to_aoe_damage_percent = 0.5
