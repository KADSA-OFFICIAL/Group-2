[gd_resource type="Resource" script_class="SkillData" load_steps=2 format=3]

[ext_resource type="Script" path="res://entities/character/SkillData.gd" id="1_skill"]

[resource]
script = ExtResource("1_skill")
skill_id = &"gangji_immunity"
display_name = "불가침"
description = "강지 고유 스킬(E, #334). **체력 비율이 가장 낮은 아군 하나**를 3초 동안 무적으로 만든다(강지 자신도 후보다). 무적인 대상은 받는 피해가 0 이고, 보호막도 깎이지 않고, 지속 피해도 들어가지 않는다 — 판정은 take_damage() 맨 앞이다(gangji_immunity 효과). 대상 선정은 설아 3타 회복(ally_heal)과 같은 규칙(_lowest_health_ally)을 쓴다. 조준을 요구하지 않는 이유: 이 프로젝트에는 아직 대상 선정 프레임워크가 없고, 표본이 적은 상태에서 만들면 한 캐릭터 기준으로 굳는다(SkillData 맨 아래 '아직 필드가 아닌 것'). 대신 '가장 위태로운 아군'은 이 스킬을 쓰는 이유와 거의 항상 일치한다. **쿨타임 45 초는 이 스킬의 대가다** — 3초를 언제 쓰느냐가 전부이고, 잘못 쓰면 45초 동안 없다. 3초는 [확정 스펙]이고 45초는 [임시값]이다(로스터에서 가장 긴 쿨타임 — 설아 E 24초, 하랑 E 30초). base_power 0 — 스스로 피해를 내지 않는다. scales_with_faith 는 무적에 세기가 없어 의미가 없으므로 껐다."
base_power = 0
scales_with_faith = false
cooldown = 45.0
ally_effect_id = &"gangji_immunity"
input_slot = 2
