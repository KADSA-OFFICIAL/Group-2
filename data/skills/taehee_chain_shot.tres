[gd_resource type="Resource" script_class="SkillData" load_steps=2 format=3]

[ext_resource type="Script" path="res://entities/character/SkillData.gd" id="1_skill"]

[resource]
script = ExtResource("1_skill")
skill_id = &"taehee_chain_shot"
display_name = "튕기는 탄"
description = "태희 고유 스킬(Q, #263). 시전하면 chain_duration 초 동안 태희의 평타 투사체가 맞은 뒤 **다음 적에게 튕긴다.** 첫 명중 대상 외에 **최대 chain_bounces 명까지 추가로** 맞힌다(3 이면 최대 4체). 이미 맞힌 적에게는 다시 튕기지 않고, chain_range 안에 아직 맞지 않은 적이 없으면 거기서 끝난다. 튕긴 타격은 피해가 chain_damage_percent 만큼 **누적 감쇠**한다(0.6 -> 0.36 -> 0.216) — 감쇠가 없으면 창이 열린 동안 화력이 그대로 4배가 된다. 튕긴 타격도 평타의 규칙 전부(처형·피흡·표식)를 그대로 탄다. 피해가 즉시 나가는 스킬이 아니라 **평타를 강화하는 창**이므로 base_power 가 0 이다 — 이 스킬의 값어치는 창 안에 평타를 몇 번 넣느냐로 정해지고, 그래서 원거리 1단계 스택(공속)이 곧 이 스킬의 세기가 된다. 겹쳐 써도 남은 시간이 누적되지 않고 갱신된다. [이름 미정] — display_name 은 기능을 그대로 적은 임시 이름이다. 수치는 전부 [임시값]이다."
base_power = 0
scales_with_faith = false
cooldown = 12.0
chain_duration = 5.0
chain_bounces = 3
chain_range = 220.0
chain_damage_percent = 0.6
input_slot = 1
