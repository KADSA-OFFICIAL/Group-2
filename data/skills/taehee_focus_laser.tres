[gd_resource type="Resource" script_class="SkillData" load_steps=2 format=3]

[ext_resource type="Script" path="res://entities/character/SkillData.gd" id="1_skill"]

[resource]
script = ExtResource("1_skill")
skill_id = &"taehee_focus_laser"
display_name = "집속 레이저"
description = "태희 고유 스킬(E, #263). 누르면 바로 나가지 않고 **시전 시간**을 기다린 뒤 바라보는 방향으로 직선 레이저를 쏜다. 길이 beam_length x 폭 beam_width 의 띠 안에 있는 적 **전체를 관통**해 때린다(앞의 적이 막아 주지 않는다). 피해는 맞은 적의 **현재 체력 x current_hp_damage_percent** 에 최소 보장치 base_power 를 더한 값이다 — 대상마다 다르고, 체력이 많이 남은 적일수록 많이 아프다. 뒤집으면 깎일수록 덜 아프므로 마무리는 못 하며, base_power 가 그 하한이다. 방어력은 기존 규약대로 대상의 take_damage() -> PlayerStats.apply_defense() 가 적용한다(피해 공식을 우회하지 않는다). **실제 시전 시간 = cast_time / 공속 배수**다 — 원거리 1단계 스택이 공속을 올리면 캐스트가 함께 짧아진다. 캐스트 중에는 평타가 나가지 않으므로 그 짧아진 시간이 곧 안전이다. 그리고 **평타 1회마다 남은 쿨타임이 cooldown_reduction_per_attack 초씩 줄어든다**(발생 기준이라 빗나간 탄도 준다). 쿨타임은 **누른 시점**부터 도는데, 캐스트가 끝난 뒤부터 돌면 캐스트를 당길수록 다음 시전까지의 총 대기가 길어져 강화가 손해가 되기 때문이다. 평타가 아니므로 처형·피흡·표식은 걸리지 않는다. [이름 미정] — display_name 은 기능을 그대로 적은 임시 이름이다. 수치는 전부 [임시값]이다."
base_power = 80
scales_with_faith = true
cooldown = 16.0
cast_time = 1.2
beam_length = 520.0
beam_width = 60.0
current_hp_damage_percent = 0.25
cooldown_reduction_per_attack = 0.5
input_slot = 2
