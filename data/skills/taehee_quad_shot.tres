[gd_resource type="Resource" script_class="SkillData" load_steps=2 format=3]

[ext_resource type="Script" path="res://entities/character/SkillData.gd" id="1_skill"]

[resource]
script = ExtResource("1_skill")
skill_id = &"taehee_quad_shot"
display_name = "4타 광역탄"
description = "태희 평타 패시브(#263). 태희 평타는 **원거리 투사체**다 — 이 프로젝트의 첫 플레이어 원거리 평타이며, 그전까지 플레이어 평타는 전원 근접 즉시타격이었다(docs §3 의 '후속 과제'). 평타가 4번 나갈 때마다(적중이 아니라 발생 기준, 미나의 3타 패시브와 같은 규약) 그 탄이 **착탄 지점에서 원형 광역으로** 터진다. 광역 위력은 시전자 **물리 공격력 x attack_aoe_power_percent** 이고, 반경 안의 적 전원이 같은 값을 맞는다. aoe_at_projectile_impact = true 라 시전자 발밑이 아니라 탄이 멈춘 자리에서 터진다 — 원거리 캐릭터의 광역이 자기 발밑에서 나면 사거리의 의미가 없다. 회복 채널(heal_missing_hp_percent)을 쓰지 않으므로 체력과 무관하게 항상 같은 비율로 나간다. 발동형이 아니라 평타에 붙는 패시브이므로 키 슬롯이 없다. [이름 미정] — display_name 은 기능을 그대로 적은 임시 이름이다. 수치는 전부 [임시값]이다. attack_aoe_power_percent = 1.0 은 '4타째는 평타와 같은 위력이 광역으로 들어간다'는 뜻이며, 화력이 과하면 가장 먼저 내릴 값이다."
summary = "평타가 일정 횟수 나갈 때마다 그 탄이 착탄 지점에서 광역으로 터진다. 태희 발밑이 아니라 탄이 멈춘 자리에서 터지므로 멀리 있는 무리에도 닿는다."
base_power = 0
scales_with_faith = false
aoe_radius = 100.0
every_n_attacks = 4
attack_aoe_power_percent = 1.0
aoe_at_projectile_impact = true
