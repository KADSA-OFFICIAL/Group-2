[gd_resource type="Resource" script_class="StatusEffectData" load_steps=2 format=3]

[ext_resource type="Script" path="res://entities/combat/StatusEffectData.gd" id="1_effect"]

[resource]
script = ExtResource("1_effect")
kind = 4
stacking = 0
max_stacks = 1
effect_id = &"empowered"
display_name = "고양"
description = "설아 E 가 파티 전원에게 거는 공세 버프(#276). 걸린 동안 ① 자기가 준 **모든** 피해를 grants_lifesteal_percent 만큼 회복하고(평타뿐 아니라 스킬·광역 패시브까지), ② 평타로 **처형**할 수 있다 — 버퍼 1단계 시너지가 꺼져 있어도, 대상에게 디버프가 없어도 된다. 체력 임계치(CombatTuning.execute_hp_percent)는 그대로 지킨다. 원거리 3단계 피흡(평타 한정)과 **별개 채널**이라 둘 다 켜져 있으면 평타는 양쪽에서 회복한다. 버프이므로 is_debuff = false 다 — 아군에게 걸리는 효과가 디버프로 세어지면 버퍼 처형의 조건을 아군이 만족시키게 된다. 중첩은 REFRESH(지속시간만 갱신) — 세기가 누적되면 설아 둘을 넣을 수 없는 로스터에서 의미가 없고, 겹쳐 쓸수록 흡혈이 무한히 커진다. 수치는 [임시값]이다."
is_debuff = false
duration = 3.0
grants_lifesteal_percent = 0.5
grants_execute = true
