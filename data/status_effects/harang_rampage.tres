[gd_resource type="Resource" script_class="StatusEffectData" load_steps=2 format=3]

[ext_resource type="Script" path="res://entities/combat/StatusEffectData.gd" id="1_effect"]

[resource]
script = ExtResource("1_effect")
kind = 0
stacking = 0
max_stacks = 1
effect_id = &"harang_rampage"
display_name = "폭주"
description = "하랑 E 가 **자신에게만** 거는 자기 강화의 첫 고리(#328). 이 효과 자신은 **공속 +200%**(배수 3.0)다. 나머지 둘은 동반 효과로 이어진다: harang_rampage_leech(모든 피해 50% 흡혈) -> harang_rampage_burn(1초마다 최대 체력 7% 자기 피해). 셋을 한 효과로 담지 않은 이유는 kind 가 하나뿐이기 때문이다 — 공속은 STAT_MOD, 흡혈은 EMPOWER, 지속 피해는 PERIODIC 이고 조회하는 곳이 각각 다르다(StatusEffectData.also_apply_effect_id 주석). 셋의 duration 이 모두 7.0 인 것은 우연이 아니다: 해제는 연쇄되지 않고 각자 만료되므로, 함께 시작한 상태가 함께 끝나려면 같은 값이어야 한다. is_debuff = false 다 — 아군에게 걸리는 효과가 디버프로 세어지면 버퍼 처형 조건을 아군이 만족시킨다(empowered.tres 와 같은 판단). 자기 피해 쪽(harang_rampage_burn)만 예외로 true 다. 중첩은 REFRESH: 체력 30% 미만에서만 쓸 수 있는 스킬이라 겹쳐 쓰는 일이 드물고, 세기가 누적되면 공속이 무한히 오른다. 지속시간 7초와 +200% 는 [확정 스펙]이다."
is_debuff = false
duration = 7.0
also_apply_effect_id = &"harang_rampage_leech"
stat_percent = {
"attack_speed": 2.0
}
