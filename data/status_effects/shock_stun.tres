[gd_resource type="Resource" script_class="StatusEffectData" load_steps=2 format=3]

[ext_resource type="Script" path="res://entities/combat/StatusEffectData.gd" id="1_effect"]

[resource]
script = ExtResource("1_effect")
kind = 1
stacking = 0
max_stacks = 1
effect_id = &"shock_stun"
display_name = "감전"
description = "ranged_tank 의 낙뢰 평타에 맞은 적이 걸리는 **0.3초 기절**(#336). 이동·평타·스킬이 모두 막히는 것은 stun 과 같지만 **지속시간이 다르고 출처가 다르다.** stun(2.0초)은 탱커 표식이 임계치에 도달했을 때 터지는 한 방이고, 이쪽은 평타마다 걸리는 짧은 끊김이다 — 같은 효과를 지속시간만 바꿔 재사용하면 표식 폭발의 기절까지 0.3초가 되거나 평타 기절이 2초가 된다. 지속시간은 효과 자신의 성질이므로 효과를 따로 둔다(프로젝트 규약). **0.3초는 [확정 스펙]이다.** 짧지만 평타마다 들어가므로, 공속이 오를수록(원거리 1단계 스택, E 과부하) 적이 거의 계속 끊긴다 — 그것이 이 인물의 탱커 몫이다. 중첩은 REFRESH: 세기가 누적될 것이 없고, 여러 적이 겹쳐 맞을 때 갱신되는 편이 예측 가능하다. is_debuff = true — CC 이므로 디버프이고, **버퍼 처형의 조건을 만족시킨다**(stun 과 같은 판단). 낙뢰 평타가 적을 계속 처형 사거리에 올려 준다는 뜻이라 버퍼와 함께 쓸 때 의미가 생긴다."
is_debuff = true
duration = 0.3
blocks_movement = true
blocks_attack = true
blocks_skill = true
