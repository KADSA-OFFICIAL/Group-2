[gd_resource type="Resource" script_class="StatusEffectData" load_steps=2 format=3]

[ext_resource type="Script" path="res://entities/combat/StatusEffectData.gd" id="1_effect"]

[resource]
script = ExtResource("1_effect")
kind = 4
stacking = 0
max_stacks = 1
effect_id = &"harang_rampage_leech"
display_name = "폭주 - 흡혈"
description = "폭주(harang_rampage)의 둘째 고리(#328). 걸린 동안 하랑이 준 **모든** 피해의 50% 를 회복한다 — 평타뿐 아니라 스킬·광역 패시브까지 전부다(EnemyBase.take_damage -> Player.on_damage_dealt). 이 흡혈이 폭주의 생존 수단이다: 같은 7초 동안 최대 체력 49% 를 스스로 태우므로, 때리지 못하면 그대로 죽는다. 그래서 흡혈과 자기 피해는 같은 스킬의 앞뒤 면이고 지속시간이 같다. 설아 E 의 empowered 와 **같은 채널**(grants_lifesteal_percent)이라 둘이 겹치면 합산된다 — 서로 다른 스킬이 준 흡혈은 별개 출처이므로 큰 쪽만 남기지 않는다(StatusEffectSystem.get_granted_lifesteal). 처형은 부여하지 않는다: 처형은 버퍼 시너지와 설아 E 의 몫이고, 하랑 E 의 정체성은 '최대 체력 비례 광역'이라 마무리 수단이 이미 있다. 넘치는 회복은 보호막이 되지 않는다(원거리 3단계의 성질이다). 흡혈 50% 와 지속시간 7초는 [확정 스펙]이다."
is_debuff = false
duration = 7.0
also_apply_effect_id = &"harang_rampage_burn"
grants_lifesteal_percent = 0.5
