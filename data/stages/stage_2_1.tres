[resource]
script = ExtResource("1_stagedata")
stage_id = &"stage_2_1"
display_name = "2-1 밀물 해안"
chapter = 2
number = 1
description = "**2챕터(바다)의 첫 스테이지(#438).** 이 스테이지의 목적은 해변 맵(#422)이 실제 전투 배경으로 나오게 하는 것이다 — 맵과 컨셉->씬 대응(StageMaps)은 이미 있었고 그것을 쓰는 데이터가 없어 BeachMap 이 게임에서 한 번도 인스턴스되지 않았다. type = BATTLE(소탕): 점령 구조는 1-2 가 이미 보여 주므로 여기서 겹치지 않고, 처음 보는 지형에서 배치만 읽게 둔다. 적 넷은 1챕터에 저작된 적을 쓴다(바다 컨셉 전용 적은 아직 없다) — 벨로시랩터 수인 둘이 앞, 매머드 수인 둘이 뒤다. 1-1(랩터 둘 + 매머드 하나)보다 매머드가 하나 늘어 앞줄을 정리한 뒤에도 단단한 둘이 남는다. **스폰 자리를 물가 쪽으로 내렸다**: 파티 시작 자리는 (100,100~180)이고 적은 y 240~410 에 있어 전투가 젖은 모래·얕은 물 띠에서 일어난다. 마른 모래 안쪽에만 놓으면 '해변'이라고 적힌 맵이 모래밭으로만 보인다(#422 가 미리보기 framing 을 물가에 맞춘 것과 같은 이유다). 물은 밟을 수 있는 바닥이라 배치를 막지 않는다. 네 마리 모두 파티 시작 자리에서 detection_range(600) 안이라 시작하자마자 접근이 일어난다. 보상은 1-2(60/60/40)보다 크고 1챕터 보스 1-3(150/180/90)보다 작게 잡았다 — 새 챕터의 첫 일반 스테이지가 앞 챕터 보스보다 더 주면 보스를 도는 편이 낫게 된다. 전부 [임시값]이다. 강제 파티를 두지 않는다(튜토리얼이 아니다). **2-2 · 2-3 은 아직 없다** — 챕터를 채우는 것은 밸런스 저작 작업이라 별도로 다룬다."
type = 0
clear_rewards = {
"gold": 110,
"protein": 120,
"stone": 70
}
spawns = Array[ExtResource("2_spawn")]([SubResource("StageSpawn_raptor"), SubResource("StageSpawn_raptor2"), SubResource("StageSpawn_mammoth")])
