[resource]
script = ExtResource("1_stagedata")
stage_id = &"stage_3_1"
display_name = "3-1 구름 다리"
chapter = 3
number = 1
briefing = "납치된 소꿉친구를 구하러 하늘섬으로 향하는 구출대. 구름 위 바위 다리에서 여왕의 익룡 병사들이 길을 막는다. 멀리서 쏘아 대는 익룡 수인부터 흩어 놓자."
description = "**3챕터(하늘) 첫 스테이지(#567, 설계 #564, 테마 적 교체 #568).** 일반 스테이지. 새 챕터의 첫 판이라 2-3 보스보다 **쉽고 덜 준다**(2-1 < 1-3 과 같은 원칙 — gold 240 < 2-3 의 280). type = BATTLE(소탕), spawns 는 비우고 웨이브만 쓴다. 점령 타입을 쓰지 않는다: 턴제에는 점령 대응물이 없어(설계서 §18) 점령 스테이지는 턴제에서 원래 의도보다 쉬워진다.

1파 「추격대 선봉」 익룡 수인 ×2 · 랩터 수인 · 서아 / 2파 「추격대 본대」 매머드 수인 · 서아 · 랩터 수인 2. 1파는 여왕의 익룡 병사(한기 · 충격 약점 → 설아 · 하랑)가 앞에서 몰려온다(#568 이 랩터 수인 2 ×2 를 교체). 2파에는 랩터 수인 2(전격 · 관통 약점)를 남겨 아린이 빛날 자리를 둔다. 익룡 수인은 **아트가 아직 없어 도형 플레이스홀더**로 선다.

**turn_level_bonus = 6** → 익룡 수인 27 · 랩터 26 · 매머드/서아 28. 좌표는 하늘 본섬(셀 중심 (24,20), 반지름 (22,13) 셀의 일그러진 타원 → 세계 중심 약 (348,252), 반지름 약 (528,312)px) 안쪽 80% 타원(약 440 x 260) 안이다. 섬 밖은 허공 충돌이라 거기에 놓이면 끼어서 못 움직인다(#448 과 같은 종류). 실시간으로 진입해 모든 적이 섬 위에서 움직이는 것을 확인했다. 파티 시작 (100,100~180)에서 1파의 가장 가까운 적이 탐지 범위 600 안이다.

보상 [임시값] gold 240 / protein 240 / iron_ore 3 / coal 3 / hudamantium 4 (재화 5종 이하). 3챕터 첫 클리어 + 3-2 ×2 + 3-1 ×2 → 후다만티움 4부위(huda 27 · coal 23 · gold 2260)를 맞춘다(설계 #564 §3).

실측 (VerifyStageDifficulty, 표준 파티, 시드 8, 예상 프로필 P2 = 삼각근 Lv.7 + 철 장비, #563 반영): 8/8 승 · 평균 9.6사이클 · 남은 HP 91% / 딜러 파티 8/8 · 85%. 48시드: 표준 48/48 · 95%, 장비만 48/48 · 90%, 딜러 48/48 · 87%."
type = 0
turn_level_bonus = 6
clear_rewards = {
"gold": 240,
"protein": 240,
"iron_ore": 3,
"coal": 3,
"hudamantium": 4
}
spawns = Array[ExtResource("2_spawn")]([])
waves = Array[ExtResource("3_wave")]([SubResource("Wave_1"), SubResource("Wave_2")])
