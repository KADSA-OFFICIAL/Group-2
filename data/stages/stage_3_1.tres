[resource]
script = ExtResource("1_stagedata")
stage_id = &"stage_3_1"
display_name = "3-1 구름 다리"
chapter = 3
number = 1
briefing = "납치된 소꿉친구를 구하러 하늘섬으로 향하는 구출대. 구름 위 바위 다리에서 여왕이 보낸 추격대가 길을 막는다. 재빠른 랩터 수인부터 흩어 놓자."
description = "**3챕터(하늘) 첫 스테이지(#567, 설계 #564).** 일반 스테이지. 새 챕터의 첫 판이라 2-3 보스보다 **쉽고 덜 준다**(2-1 < 1-3 과 같은 원칙 — gold 240 < 2-3 의 280). type = BATTLE(소탕), spawns 는 비우고 웨이브만 쓴다. 점령 타입을 쓰지 않는다: 턴제에는 점령 대응물이 없어(설계서 §18) 점령 스테이지는 턴제에서 원래 의도보다 쉬워진다. 적은 기존 6종 재사용(하늘 전용 익룡 수인은 후속 #568) — 그래서 하늘에서 육지 수인과 싸운다.

1파 「추격대 선봉」 랩터 수인 2 ×2 · 랩터 수인 · 서아 / 2파 「추격대 본대」 매머드 수인 · 서아 · 랩터 수인 2. 랩터 수인 2(전격 · 관통 약점) 위주라 스토리 5장에 합류하는 아린이 빛난다.

**turn_level_bonus = 6** → 랩터 26 · 매머드/서아 28. 좌표는 하늘 본섬(셀 중심 (24,20), 반지름 (22,13) 셀의 일그러진 타원 → 세계 중심 약 (348,252), 반지름 약 (528,312)px) 안쪽 80% 타원(약 440 x 260) 안이다. 섬 밖은 허공 충돌이라 거기에 놓이면 끼어서 못 움직인다(#448 과 같은 종류). 실시간으로 진입해 모든 적이 섬 위에서 움직이는 것을 확인했다. 파티 시작 (100,100~180)에서 1파의 가장 가까운 적이 탐지 범위 600 안이다.

보상 [임시값] gold 240 / protein 240 / iron_ore 3 / coal 3 / hudamantium 4 (재화 5종 이하). 3챕터 첫 클리어 + 3-2 ×2 + 3-1 ×2 → 후다만티움 4부위(huda 27 · coal 23 · gold 2260)를 맞춘다(설계 #564 §3).

실측 (VerifyStageDifficulty, 표준 파티 미나·하랑·설아·강지, 시드 8, 예상 프로필 P2 = 삼각근 Lv.7 + 철 장비, #563 반영): 8/8 승 · 평균 10.2사이클 · 남은 HP 93% / 딜러 파티(미나·하랑·아린·태희) 8/8 · 83%. 48시드: 48/48 · 94%."
type = 0
turn_level_bonus = 6
clear_rewards = {
"gold": 240,
"protein": 240,
"iron_ore": 3,
"coal": 3,
"hudamantium": 4
}
spawns = Array[ExtResource("2_spawn")]([])
waves = Array[ExtResource("3_wave")]([SubResource("Wave_1"), SubResource("Wave_2")])
