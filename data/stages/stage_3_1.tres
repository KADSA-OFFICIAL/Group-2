; ===== 1파 — 추격대 선봉 =====
; 전부 본섬 안쪽 80% 타원(중심 (348,252), 반지름 약 440 x 260) 안이다. 섬 밖은 허공 충돌이라 거기에 놓이면 끼어서 못 움직인다.
; 익룡 수인 2(한기 · 충격 약점)가 앞에서 몰려온다 — 설아 · 하랑이 인성치를 깎는다. 랩터 수인 하나와 서아가 뒤를 받친다.

[sub_resource type="Resource" id="Spawn_w1_ptero_1"]
script = ExtResource("2_spawn")
enemy_scene = ExtResource("4_ptero")
position = Vector2(480, 220)
count = 2
offset = Vector2(80, 40)

[sub_resource type="Resource" id="Spawn_w1_raptor_2"]
