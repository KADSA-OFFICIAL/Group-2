label = "추격대 선봉"
is_boss = false

; ===== 2파 — 추격대 본대 =====
; 앞을 뚫은 뒤에 오는 단단한 쪽. 매머드 수인이 앞(560,260)에서 막고 서아가 뒤(660,320)에서 받친다.
; 랩터 수인 2(전격 · 관통 약점)는 여기에 남겼다 — 아린이 빛나는 자리다.

