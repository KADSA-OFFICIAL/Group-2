[resource]
script = ExtResource("1_stagedata")
stage_id = &"stage_1_1"
display_name = "1-1 시험장"
description = "첫 전투. 네 마리 — 서아·매머드 수인·벨로시랩터 수인 둘 — 이 스폰 지점부터 파티를 향해 다가온다(#208 로 탐지 범위가 600 이 되어 스폰 거리 500~531px 가 범위 안이다). 벨로시랩터 둘(#340, #342 — 스탯이 같고 외형만 다르다)이 가장 먼저 붙어 난타하지만 물몸이라 빨리 죽고, 서아가 그 다음, 매머드는 느리지만 단단하다."
type = 0
clear_rewards = {
"gold": 40,
"protein": 50,
"stone": 25
}
spawns = Array[ExtResource("2_spawn")]([SubResource("StageSpawn_seoa"), SubResource("StageSpawn_mammoth"), SubResource("StageSpawn_raptor"), SubResource("StageSpawn_raptor2")])
