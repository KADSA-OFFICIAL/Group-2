[gd_resource type="Resource" script_class="StageData" load_steps=4 format=3]

[ext_resource type="Script" path="res://entities/stage/StageData.gd" id="1_stagedata"]
[ext_resource type="Script" path="res://entities/stage/StageSpawn.gd" id="2_spawn"]
[ext_resource type="PackedScene" path="res://entities/enemies/MammothBoss.tscn" id="5_boss"]

[sub_resource type="Resource" id="StageSpawn_boss"]
script = ExtResource("2_spawn")
enemy_scene = ExtResource("5_boss")
position = Vector2(700, 280)
count = 1
offset = Vector2(100, 0)

[resource]
script = ExtResource("1_stagedata")
stage_id = &"stage_1_3"
display_name = "1-3 우두머리의 자리"
description = "첫 보스 스테이지(#376). 매머드 수인 우두머리 한 마리만 놓는다 — 잡몹을 섞지 않은 이유는 보스의 예고를 읽는 것이 이 판의 전부이기 때문이다. 다른 적이 붙어 있으면 준비자세와 착지 예고를 볼 여유가 없어 회피가 운이 된다. 스폰 거리는 파티 시작 자리에서 약 600px 라 보스의 detection_range(800) 안이고, attack_range(110) 밖이라 **첫 접근이 대시로 일어난다** — 이 적이 일반 매머드와 다르다는 것이 시작하자마자 드러난다. forced_party 를 두지 않는다: 1-1 은 튜토리얼이라 순혈 3인을 강제하지만, 여기는 배운 것을 자기 편성으로 시험하는 자리다. type = BATTLE(소탕) — 점령은 §5.2 가 [미정]이라 판정할 수단이 없다. 보상은 1-1(40/50/25) 보다 크게 잡았으나 [임시값]이며, 보스 전용 드롭 테이블은 아직 없다(보상 규칙이 clear_rewards 하나뿐이다). **1-2 는 아직 없다** — 스테이지 번호가 이어지지 않는 것은 알고 있으며, 지금 해금 사슬이 없어(StageProgress 는 클리어 횟수만 기록) 1-3 만 있어도 고르고 플레이할 수 있다."
type = 0
clear_rewards = {
"gold": 150,
"protein": 180,
"stone": 90
}
spawns = Array[ExtResource("2_spawn")]([SubResource("StageSpawn_boss")])
