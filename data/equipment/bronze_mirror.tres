[gd_resource type="Resource" script_class="EquipmentData" load_steps=2 format=3]

[ext_resource type="Script" path="res://entities/equipment/EquipmentData.gd" id="1_equipmentdata"]

[resource]
script = ExtResource("1_equipmentdata")
equipment_id = &"bronze_mirror"
display_name = "청동 거울"
description = "청동 티어 거울. 여신의 스킬 강화를 올린다. 청동은 주석(tin)과 구리(copper)로 제작한다. 제작 비용은 [임시값]이며 밸런싱 대상이다. 스텟 값의 근거(이슈 354): 티어1 풀세트(도끼 + 방어구 3부위)가 기본 스텟 블록(HP 1000 / 근력 100 / 방어 100) 대비 전투력 +25% 가 되게 잡고 티어마다 x1.6 을 적용했다(티어2 +40% / 티어3 +64%). 이전 값은 최종 티어를 다 갖춰도 물리공격이 +7.5% 밖에 오르지 않아, BalanceReference 가 파생하는 적 기준선이 티어1에서 티어3 사이에 8% 만 움직였다."
summary = "청동을 닦아 만든 거울. 여신의 힘을 받아 스킬을 강하게 한다."
slot = 4
tier = 1
goddess_skill_boost_bonus = 0.2
craft_cost = {
"copper": 6,
"gold": 200,
"tin": 6
}
