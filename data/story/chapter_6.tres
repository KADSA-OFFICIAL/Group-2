[ext_resource type="Script" path="res://entities/story/StoryLineData.gd" id="2"]
[ext_resource type="Texture2D" path="res://assets/sprites/backgrounds/village.png" id="bg_village"]
[ext_resource type="Texture2D" path="res://assets/sprites/backgrounds/forest.png" id="bg_forest"]
[ext_resource type="Texture2D" path="res://assets/sprites/backgrounds/highland.png" id="bg_realm"]

[sub_resource type="Resource" id="L0"]
script = ExtResource("2")
text = "마을로 돌아온 주인공과 일행들."

[sub_resource type="Resource" id="L1"]
script = ExtResource("2")
kind = 1
speaker = "마을사람들"
text = "오 돌아왔다!"

[sub_resource type="Resource" id="L2"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "여왕을 쓰러뜨렸습니다! 이제 모든 위협이 사라졌어요!"

[sub_resource type="Resource" id="L3"]
script = ExtResource("2")
kind = 1
speaker = "마을사람들"
text = "(주인공이름) 만만세!"

[sub_resource type="Resource" id="L4"]
script = ExtResource("2")
text = "마을에서 축제를 연다. 주인공은 여러 인물과 대화할 수 있다."

[sub_resource type="Resource" id="L5"]
script = ExtResource("2")
text = "설아와 대화한다."

[sub_resource type="Resource" id="L6"]
script = ExtResource("2")
kind = 1
speaker = "설아"
character_id = &"seola"
text = "여왕을 쓰러뜨려줘서 고마워. 멋졌어."

[sub_resource type="Resource" id="L7"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "나도 알아. 핳"

[sub_resource type="Resource" id="L8"]
script = ExtResource("2")
kind = 1
speaker = "설아"
character_id = &"seola"
text = "....그래."

[sub_resource type="Resource" id="L9"]
script = ExtResource("2")
text = "하랑과 대화한다."

[sub_resource type="Resource" id="L10"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "이것좀 먹어. 도와줘서 고마워."

[sub_resource type="Resource" id="L11"]
script = ExtResource("2")
kind = 1
speaker = "하랑"
character_id = &"harang"
text = "우물우물..! 우에? 아니에요! 저야말로 감사드려요! 덕분에 축제도 열고 맛있는 음식도 이렇게나 잔뜩 먹을 수 있고..헤헤."

[sub_resource type="Resource" id="L12"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "즐거워보이니 다행이네. 모처럼 축제하는거 같은데 많이 먹어둬."

[sub_resource type="Resource" id="L13"]
script = ExtResource("2")
kind = 1
speaker = "하랑"
character_id = &"harang"
text = "우물우물우물…(끄덕)"

[sub_resource type="Resource" id="L14"]
script = ExtResource("2")
text = "태희와 대화한다."

[sub_resource type="Resource" id="L15"]
script = ExtResource("2")
kind = 1
speaker = "태희"
character_id = &"taehee"
text = "덕분에 오랜만에 피터지는 싸움을 즐겼다. 수고했다고!"

[sub_resource type="Resource" id="L16"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "그래..뭐 즐거우면 됐지 뭐..축제도 즐길 수 있으면 좋겠네."

[sub_resource type="Resource" id="L17"]
script = ExtResource("2")
kind = 1
speaker = "태희"
character_id = &"taehee"
text = "다시 싸우고 싶다!"

[sub_resource type="Resource" id="L18"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "엄..ㅋㅋ"

[sub_resource type="Resource" id="L19"]
script = ExtResource("2")
text = "미나와 대화한다."

[sub_resource type="Resource" id="L20"]
script = ExtResource("2")
kind = 1
speaker = "미나"
character_id = &"mina"
text = "축제, 너무 너무 너무 너어~~무 즐거워어~!"

[sub_resource type="Resource" id="L21"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "친구는 많이 사귀었어?"

[sub_resource type="Resource" id="L22"]
script = ExtResource("2")
kind = 1
speaker = "미나"
character_id = &"mina"
text = "응, 덕분에! 진심 고마워!"

[sub_resource type="Resource" id="L23"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "그래, 축제 마저 재밌게 즐기시고~"

[sub_resource type="Resource" id="L24"]
script = ExtResource("2")
kind = 1
speaker = "미나"
character_id = &"mina"
text = "응!"

[sub_resource type="Resource" id="L25"]
script = ExtResource("2")
text = "아린과 대화한다."

[sub_resource type="Resource" id="L26"]
script = ExtResource("2")
kind = 1
speaker = "아린"
character_id = &"arin"
text = "쿨~"

[sub_resource type="Resource" id="L27"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "축제 시끄러울텐데 잘도 자네.."

[sub_resource type="Resource" id="L28"]
script = ExtResource("2")
kind = 1
speaker = "아린"
character_id = &"arin"
text = "쿨!"

[sub_resource type="Resource" id="L29"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "이젠 잠든채로 대화하는 지경까지 왔어..! 크흠.. 뭐 암튼 너도 축제 재밌게 즐기라고."

[sub_resource type="Resource" id="L30"]
script = ExtResource("2")
kind = 1
speaker = "아린"
character_id = &"arin"
text = "쿨쿨~!"

[sub_resource type="Resource" id="L31"]
script = ExtResource("2")
text = "강지와 대화한다."

[sub_resource type="Resource" id="L32"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "같이 여왕을 쓰러뜨려줘서 고마워! 덕분에 도움이 많이 됐어!"

[sub_resource type="Resource" id="L33"]
script = ExtResource("2")
kind = 1
speaker = "강지"
character_id = &"gangji"
text = "ㅇ..ㅇ어ㅇ어엇! 너도 수고했어! 여왕 쓰러뜨릴 때 멋지더라..다시 봤어.."

[sub_resource type="Resource" id="L34"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "어디 아픈건 아니지?"

[sub_resource type="Resource" id="L35"]
script = ExtResource("2")
kind = 1
speaker = "강지"
character_id = &"gangji"
text = "ㅇ..아니아니! 쌩쌩해! 축제도 즐겁고! 자, 너도 빨리 축제를 즐기러 가라고!(주인공을 민다)"

[sub_resource type="Resource" id="L36"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "ㅋ..크헉(각혈을 뿜는다)"
screen_effect = 2

[sub_resource type="Resource" id="L37"]
script = ExtResource("2")
text = "소꿉친구와 대화한다."

[sub_resource type="Resource" id="L38"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "여왕한테 잡혀있느라 많이 힘들었지? 수고했어 ㅎㅎ."

[sub_resource type="Resource" id="L39"]
script = ExtResource("2")
kind = 1
speaker = "소꿉친구"
character_id = &"childhood_friend"
text = ".....고마워.."

[sub_resource type="Resource" id="L40"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "뭐라고?"

[sub_resource type="Resource" id="L41"]
script = ExtResource("2")
kind = 1
speaker = "소꿉친구"
character_id = &"childhood_friend"
text = "구해줘서 고맙다구!!(도망친다)"

[sub_resource type="Resource" id="L42"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "(부끄러워하긴)"

[sub_resource type="Resource" id="L43"]
script = ExtResource("2")
background = ExtResource("bg_forest")
text = "축제가 끝난 새벽. 잠이 오지 않는 주인공은 마을 주변 숲을 산책한다."
screen_effect = 1

[sub_resource type="Resource" id="L44"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "그러고보니까 여왕을 처리했는데 여신님은 왜 안나타나는거지? 농땡이 피우는거 아니야?"

[sub_resource type="Resource" id="L45"]
script = ExtResource("2")
kind = 1
speaker = "여신"
character_id = &"goddess"
text = "아니거든!"

[sub_resource type="Resource" id="L46"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "우와악! 깜짝 놀랐잖아요!"

[sub_resource type="Resource" id="L47"]
script = ExtResource("2")
kind = 1
speaker = "여신"
character_id = &"goddess"
text = "너 뭐하는거야!"

[sub_resource type="Resource" id="L48"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "뭐가요?"

[sub_resource type="Resource" id="L49"]
script = ExtResource("2")
kind = 1
speaker = "여신"
character_id = &"goddess"
text = "공룡을 멸종시켜 달라고 했잖아! 왜 아직도 있는건데!"

[sub_resource type="Resource" id="L50"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "아 공룡을 멸종시켜달라고 하셨구나..근데 이미 정들어서 못하겠어요."

[sub_resource type="Resource" id="L51"]
script = ExtResource("2")
kind = 1
speaker = "여신"
character_id = &"goddess"
text = "그렇다면 눈물을 머금고 내가 처리할수밖에.."

[sub_resource type="Resource" id="L52"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "안돼요! 제 친구들을 멸종시키려 한다면 여신이든 뭐든 신경안써요!"

[sub_resource type="Resource" id="L53"]
script = ExtResource("2")
kind = 1
speaker = "여신"
character_id = &"goddess"
text = "한낱 인간 나부랭이가 감히 신에게 덤비려 하다니..그 배짱은 인정해주지. 넌 특별히 나와 맞댈 기회를 주겠어. 너의 진심을 보여줘보도록."

[sub_resource type="Resource" id="L54"]
script = ExtResource("2")
background = ExtResource("bg_realm")
text = "주인공의 몸에서 빛이 나고 워프한다."
screen_effect = 3

[sub_resource type="Resource" id="L55"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "..! 여기는 어디지?"

[sub_resource type="Resource" id="L56"]
script = ExtResource("2")
kind = 1
speaker = "여신"
character_id = &"goddess"
text = "나의 권능으로 만들어낸 뒷세계라고나 할까. 갑자기 두려워졌나?"

[sub_resource type="Resource" id="L57"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "겠어요? 덤비세요!"

[sub_resource type="Resource" id="L58"]
script = ExtResource("2")
kind = 2
text = "최종보스전 시작. 긴 혈투 끝에 주인공 승리."

[sub_resource type="Resource" id="L59"]
script = ExtResource("2")
kind = 1
speaker = "여신"
character_id = &"goddess"
text = "큭..끈질겨.."

[sub_resource type="Resource" id="L60"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "전 한번 눈돌면 아무도 못막아요!"

[sub_resource type="Resource" id="L61"]
script = ExtResource("2")
kind = 1
speaker = "여신"
character_id = &"goddess"
text = "알겠어..내가 졌다 졌어! 고집이 이렇게 세서야..그니까 고백하고 차이지."

[sub_resource type="Resource" id="L62"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "그 얘기가 지금 왜 나와요!"

[sub_resource type="Resource" id="L63"]
script = ExtResource("2")
kind = 1
speaker = "여신"
character_id = &"goddess"
text = "근데 뭐 지금은..조금 더 듬직해졌네. 뭐 너의 진심은 잘 알겠어. 이렇게 된 이상 역사를 살짝 바꿀수 밖에.."

[sub_resource type="Resource" id="L64"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "어떻게요?"

[sub_resource type="Resource" id="L65"]
script = ExtResource("2")
kind = 1
speaker = "여신"
character_id = &"goddess"
text = "지금 이 순간부터 인류는 공룡이 진화한 형태야. 이렇게 되면 공룡은 멸종하지 않게 되고 인류도 멀쩡하게 보존되지."

[sub_resource type="Resource" id="L66"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "진작에 그 방법을 쓰면 되는거 아니에요?"

[sub_resource type="Resource" id="L67"]
script = ExtResource("2")
kind = 1
speaker = "여신"
character_id = &"goddess"
text = "방금 떠올린거야. 알았으면 진작에 했겠지 바보야."

[sub_resource type="Resource" id="L68"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "...."

[sub_resource type="Resource" id="L69"]
script = ExtResource("2")
kind = 1
speaker = "여신"
character_id = &"goddess"
text = "너도 이제 곧 현대로 보내줄게 마지막으로 친구들과 인사해."

[sub_resource type="Resource" id="L70"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "네.."

[sub_resource type="Resource" id="L71"]
script = ExtResource("2")
background = ExtResource("bg_village")
text = "주인공의 몸이 빛나고 다시 워프한다."
screen_effect = 3

