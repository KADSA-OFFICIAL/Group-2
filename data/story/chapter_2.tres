[sub_resource type="Resource" id="L0"]
script = ExtResource("2")
kind = 1
speaker = "???"
text = "저기 얘! 일어나봐! 괜찮니?"
stage_id = &""

[sub_resource type="Resource" id="L1"]
script = ExtResource("2")
kind = 0
speaker = ""
text = "주인공 천천히 눈을 뜬다. 소꿉이의 얼굴이 보인다."
stage_id = &""

[sub_resource type="Resource" id="L2"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "??? 소꿉아? 너가 왜 여기에..?"
stage_id = &""

[sub_resource type="Resource" id="L3"]
script = ExtResource("2")
kind = 1
speaker = "소꿉친구"
character_id = &"childhood_friend"
text = "뭐야? 너 내 이름은 어떻게 알아? 너 스토커니?"
stage_id = &""

[sub_resource type="Resource" id="L4"]
script = ExtResource("2")
kind = 0
speaker = ""
text = "자세히 보니 옷이 가죽옷이다. 아마 과거에 있었던 그녀의 조상인 모양이다."
stage_id = &""

[sub_resource type="Resource" id="L5"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "미..미안해! 내 친구랑 닮아서..순간 걔인줄 알았어."
stage_id = &""

[sub_resource type="Resource" id="L6"]
script = ExtResource("2")
kind = 1
speaker = "소꿉친구"
character_id = &"childhood_friend"
text = "흠..그래 믿어줄게. 너 어디 다친데는 없어? 갈 곳 없으면 우리 마을로 가자. 안그래도 요즘 쉬었음 청년이 많아서 일꾼이 없어."
stage_id = &""

[sub_resource type="Resource" id="L7"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "그..그래.(성격까지 똑같다..!)"
stage_id = &""

[sub_resource type="Resource" id="L8"]
script = ExtResource("2")
kind = 0
speaker = ""
text = "주인공, 소꿉친구 마을로 간다."
stage_id = &""

[sub_resource type="Resource" id="L9"]
script = ExtResource("2")
kind = 1
speaker = "소꿉친구"
character_id = &"childhood_friend"
text = "뭐..뭐야 마을이 불타고 있잖아! 이게 어떻게 된 일이야!"
stage_id = &""

[sub_resource type="Resource" id="L10"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "우와, 날 환영하려고 캠프파이어 피운거야? 감동이다!"
stage_id = &""

[sub_resource type="Resource" id="L11"]
script = ExtResource("2")
kind = 1
speaker = "소꿉친구"
character_id = &"childhood_friend"
text = "개소리야! 보고만 있지 말고 빨리 도와줘!"
stage_id = &""

[sub_resource type="Resource" id="L12"]
script = ExtResource("2")
kind = 0
speaker = ""
text = "마을에는 용반목과 조반목 공룡 수인이 날뛰고 있다."
stage_id = &""

[sub_resource type="Resource" id="L13"]
script = ExtResource("2")
kind = 1
speaker = "브라키오 수인"
character_id = &"brachio_beastfolk"
text = "ㅈ..저희를 내버려두면 마을이 부서져 버리고 말거라구요..?"
stage_id = &""

[sub_resource type="Resource" id="L14"]
script = ExtResource("2")
kind = 1
speaker = "티라노 수인"
text = "하핳! 신난다~!"
stage_id = &""

[sub_resource type="Resource" id="L15"]
script = ExtResource("2")
kind = 1
speaker = "벨로시랩터 수인1"
text = "허접 인간!(인간을 발로 밟으며) 나가 죽어!"
stage_id = &""

[sub_resource type="Resource" id="L16"]
script = ExtResource("2")
kind = 1
speaker = "벨로시랩터 수인2"
text = "헤에~? 설마 좋아하고 있는거야아? 더러워! 역겨워! 씹덕! 오타쿠!"
stage_id = &""

[sub_resource type="Resource" id="L17"]
script = ExtResource("2")
kind = 1
speaker = "소꿉친구"
character_id = &"childhood_friend"
text = "꺄악! 마을 사람들이 당하고 있어! 빨리 도와줘!"
stage_id = &""

[sub_resource type="Resource" id="L18"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "부럽다.."
stage_id = &""

[sub_resource type="Resource" id="L19"]
script = ExtResource("2")
kind = 1
speaker = "소꿉친구"
character_id = &"childhood_friend"
text = "빨리 가서 도와주라고!"
stage_id = &""

[sub_resource type="Resource" id="L20"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "아..알았어!!"
stage_id = &""

[sub_resource type="Resource" id="L21"]
script = ExtResource("2")
kind = 2
speaker = ""
text = "전투 시작, 주인공이 이김"
stage_id = &""

[sub_resource type="Resource" id="L22"]
script = ExtResource("2")
kind = 1
speaker = "브라키오 수인"
character_id = &"brachio_beastfolk"
text = "히..히익! 잘못했어요오.."
stage_id = &""

[sub_resource type="Resource" id="L23"]
script = ExtResource("2")
kind = 1
speaker = "티라노 수인"
text = "아야! 아프다고! 그만 때려!"
stage_id = &""

[sub_resource type="Resource" id="L24"]
script = ExtResource("2")
kind = 1
speaker = "벨로시랩터 수인1"
text = "허접 벨로시랩터라 죄송해요오.."
stage_id = &""

[sub_resource type="Resource" id="L25"]
script = ExtResource("2")
kind = 1
speaker = "벨로시랩터 수인2"
text = "허접 인간에게 당하다니이..으극"
stage_id = &""

[sub_resource type="Resource" id="L26"]
script = ExtResource("2")
kind = 1
speaker = "마을 사람들"
text = "구해주셔서 감사합니다!"
stage_id = &""

[sub_resource type="Resource" id="L27"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "하핳 저도 압니다."
stage_id = &""

[sub_resource type="Resource" id="L28"]
script = ExtResource("2")
kind = 1
speaker = "마을 사람들"
text = "근데 마을이 다 부셔졌네요. 어떻게 책임지실거죠?"
stage_id = &""

[sub_resource type="Resource" id="L29"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "네?"
stage_id = &""

[sub_resource type="Resource" id="L30"]
script = ExtResource("2")
kind = 1
speaker = "마을 사람들"
text = "당신은 마을을 부신 혐의로 저희 마을의 공식적인 1호 노예가 되었습니다. 마을의 재건에 힘쓰는데 거들어야합니다."
stage_id = &""

[sub_resource type="Resource" id="L31"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "......"
stage_id = &""

[sub_resource type="Resource" id="L32"]
script = ExtResource("2")
kind = 1
speaker = "소꿉친구"
character_id = &"childhood_friend"
text = "안심해, 말은 저렇게 하지만 실제론 갈 곳 없어보여서 우리 마을에서 지내라는 뜻이야."
stage_id = &""

[sub_resource type="Resource" id="L33"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "아하, 그럴줄 알았어."
stage_id = &""

[sub_resource type="Resource" id="L34"]
script = ExtResource("2")
kind = 1
speaker = "소꿉친구"
character_id = &"childhood_friend"
text = "근데 마을이 부셔져서 다시 만들긴 해야돼, 도와줄 수 있지?"
stage_id = &""

[sub_resource type="Resource" id="L35"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "그정돈 쌉가능이지. 바로 가자."
stage_id = &""

[sub_resource type="Resource" id="L36"]
script = ExtResource("2")
kind = 1
speaker = "티라노 수인&벨로시랩터 수인"
text = "혹시 저희도 따라가도 될까요..?"
stage_id = &""

[sub_resource type="Resource" id="L37"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "..무슨 낯짝으로 그런 말을 하는거야?"
stage_id = &""

[sub_resource type="Resource" id="L38"]
script = ExtResource("2")
kind = 1
speaker = "티라노 수인"
text = "사실 우리는 오래전에 가족들에게 버림받았어. 그래서 우리끼리 뭉친거야. 우리가 불쌍하지도 않니? 다른 피해자들을 원하지 않는다면 우리를 데려가는게 좋을거야."
stage_id = &""

[sub_resource type="Resource" id="L39"]
script = ExtResource("2")
kind = 1
speaker = "주인공"
text = "(싸이코한테 잘못 걸렸군.)알았어. 같이 가자."
stage_id = &""

[sub_resource type="Resource" id="L40"]
script = ExtResource("2")
kind = 1
speaker = "티라노 수인&벨로시랩터 수인"
text = "고마워!"
stage_id = &""

