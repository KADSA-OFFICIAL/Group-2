[gd_resource type="Resource" script_class="StoryCastData" load_steps=2 format=3]

[ext_resource type="Script" path="res://entities/story/StoryCastData.gd" id="1_cast"]

[resource]
script = ExtResource("1_cast")
cast_id = &"pterosaur_queen"
display_name = "여왕"
tint = Color(0.66, 0.55, 0.8, 1)
description = "익룡 무리의 여왕. 챕터 4 에서 \"그 세력의 지도자를 잡아와라\" 한 마디로 납치를 지시한다(#305). 여신(goddess)과 같은 이유로 cast 에 둔다 — 나중에 적으로 저작되면 해석 순서상 EnemyData 가 먼저 잡히므로 이 파일만 지우면 되고 대본은 고칠 것이 없다(#202). 초상 미저작. 이름/개성 미정."
