[resource]
script = ExtResource("1_enemydata")
enemy_id = &"brachio_beastfolk"
display_name = "브라키오 수인"
description = "느리고 단단한 벽. 파티의 35% 속도로 다가와 잘 죽지 않지만, 원피해 DPS는 돌창병보다 낮아 순간에 녹이지 않는다. 처치에 걸리는 시간은 돌창병의 약 2.4배다(원거리딜러 단독 22대). 단단함의 주 레버는 방어다(물방 계수 x1.5). 근력은 돌창병보다 낮춰 위협도를 내렸다. 개성/설정/고유 스킬 미정."
stats = SubResource("PlayerStats_brachio_beastfolk")
sprite_texture = ExtResource("9_shape")
tint = Color(0.55, 0.4, 0.3, 1)
sprite_scale = Vector2(1.5, 1.5)
walk_frames = ExtResource("10_walk")
