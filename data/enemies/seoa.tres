script = ExtResource("1_enemydata")
enemy_id = &"seoa"
display_name = "서아"
description = "원거리 추적형 적. 탐지 범위(600) 안의 가장 가까운 파티 멤버를 쫓아가 사거리 250 에서 멈추고 투사체를 쏜다. 탄은 유도하지 않으므로 옆으로 움직이면 빗나간다. 밀고 들어와도 물러나지 않는다. 개성/고유 스킬 미정. #419 규격의 전용 워크 시트로 교체되어 뿔·오프숄더·꼬리가 전 방향에서 보인다."
stats = SubResource("PlayerStats_seoa")
balance_tier = 1
