[gd_resource type="Resource" script_class="SkillData" load_steps=2 format=3]

[ext_resource type="Script" path="res://entities/character/SkillData.gd" id="1_skilldef"]

[resource]
script = ExtResource("1_skilldef")
skill_id = &"boss_charge"
display_name = "돌진"
description = "매머드 수인 보스의 특별 스킬 1(#376). 체력 임계선을 지날 때 발동한다. **2초 동안 준비자세**(cast_time)를 잡고, 그 시작 시점의 대상 방향으로 직선 돌진한다. 방향을 준비 시작에 굳히는 이유: 돌진 순간에 다시 조준하면 유도 돌진이 되어 준비 2초가 회피 창이 아니라 그냥 대기 시간이 된다. 판정은 길이 700 x 폭 140 의 띠(beam_length/beam_width)이고, 예고(BossTelegraph)가 **같은 크기**로 그려진다(vfx-guide §1.2). 피해는 **대상 최대 체력의 60%**(target_max_hp_damage_percent) — 현재 체력이 아니라 최대 체력 기준이라 깎여 있든 아니든 같은 값이 들어가고 **맞으면 죽을 수 있다.** 하랑 E 가 쓰는 축과 같다. 이 무게를 준 근거는 **피할 수 있다는 것** 하나다: 준비 2초 동안 띠 밖으로 나가면 맞지 않는다. 돌진 속도는 여기 없다 — 방향이 굳은 뒤에는 속도가 회피 가능성을 바꾸지 않으므로 거동값으로 보고 MammothBoss.CHARGE_SPEED 가 갖는다(vfx-guide §1.3 예외). base_power 0: 이 스킬은 공격력 비례 피해를 내지 않는다. 700 · 140 · 2.0초 · 60% 는 전부 [임시값]이다."
base_power = 0
scales_with_faith = false
cast_time = 2.0
beam_length = 700.0
beam_width = 140.0
target_max_hp_damage_percent = 0.6
