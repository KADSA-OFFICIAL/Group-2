[ext_resource type="Script" path="res://entities/goddess/GoddessSkillData.gd" id="1_goddess"]

[resource]
script = ExtResource("1_goddess")
skill_id = &"revive"
display_name = "부활"
description = "죽은 파티원 한 명을 되살린다(#358). 최대 체력의 50%로 살아 있는 파티원 옆에 다시 선다. 여러 명이 죽어 있으면 파티 순서상 앞선 한 명이다. 되살릴 파티원이 없으면 발동하지 않고 사용 횟수도 소모하지 않는다. 회복 비율은 여신 스킬 강화 배수(신앙심 + 거울)를 타며 100%를 넘지 않는다 — 순혈 3인(배수 1.8)이면 90%다. 스테이지당 1회. 기본값 50% 는 [임시값]이다."
kind = 1
revive_hp_percent = 0.5
scales_with_boost = true
