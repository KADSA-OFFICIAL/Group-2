extends Resource
class_name PortraitMeta

# 초상마다의 **얼굴 위치·크기** (data definition).
#
# 왜 필요한가:
#   초상은 캔버스 비율과 인물 세로 점유율이 정규화되어 있다(#198). 그래서 전신으로
#   보여 줄 때는 크기가 같다. 그런데 얼굴을 크게 보여 주는 자리(목록 썸네일·파티 슬롯)는
#   **얼굴 크기**를 맞춰야 하는데, 포즈에 따라 인물 경계상자가 제각각이라
#   (팔을 벌린 그림은 넓고, 붙인 그림은 좁다) 경계상자에서 얼굴을 도출할 수 없다.
#   실제로 그렇게 했더니 같은 슬롯에서 얼굴 크기가 2배 넘게 차이 났다.
#
# 왜 런타임 자동 검출이 아닌가:
#   머리 위치를 픽셀에서 찾아내려면 머리카락·트윈테일·검은 옷을 전부 구분해야 한다.
#   실제로 시도한 판정(경계상자 폭, 밝은 살색, 어두운 눈 픽셀)이 그림마다 다른 곳을
#   짚었다. 그림 5장을 사람이 한 번 재는 편이 정확하고, 새 초상이 들어올 때도
#   한 줄 추가하면 된다.
#
# 값의 규약: Rect2 는 **캔버스 대비 비율**(0~1)이다. 픽셀이 아니다 —
# 초상마다 캔버스 크기가 다르고, 나중에 해상도가 바뀌어도 값이 그대로 유효해야 한다.
# 범위는 머리카락 꼭대기부터 턱까지이며, 가로는 얼굴 폭(머리카락 제외)이다.

## portrait_id(StringName) -> Rect2(비율). 없는 초상은 자동 추정으로 떨어진다.
@export var head_rects: Dictionary = {}


# 이 초상의 머리 범위(비율). 저작되지 않았으면 빈 Rect2 를 돌려준다.
func get_head_rect(portrait_id: StringName) -> Rect2:
	var value = head_rects.get(portrait_id, null)
	if value is Rect2 and value.size.y > 0.0:
		return value
	return Rect2()
